# StockRadar AI - Environment Configuration Example
# Copy this file to .env.local for local development if needed.

# Optional: Google Gemini API Key for AI Financial Analyst & Chatbot
# Can also be entered dynamically in the web UI settings and saved to browser localStorage.
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Local Python Server Port (defaults to 8000)
PORT=8000
